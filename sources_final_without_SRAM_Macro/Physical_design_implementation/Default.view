# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_rc_corner -name rc_best -cap_table {../../../../../../installs/FOUNDRY/digital/90nm/dig/captable/gpdk090.lef.extended.CapTbl} -T {0} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0}
create_rc_corner -name rc_worst -cap_table {../../../../../../installs/FOUNDRY/digital/90nm/dig/captable/gpdk090.lef.extended.CapTbl} -T {125} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0}
create_op_cond -name slow_rc_worst -library_file {../../../library/slow.lib} -P {1} -V {0.9} -T {125}
create_op_cond -name fast_rc_best -library_file {../../../library/fast.lib} -P {1} -V {1.1} -T {0}
create_library_set -name max_lib -timing {../../../library/slow.lib}
create_library_set -name min_lib -timing {../../../library/fast.lib}
create_constraint_mode -name sdc -sdc_files {../../inputs/sdc/systolic_array_final.sdc}
create_delay_corner -name max_delay -library_set {max_lib} -rc_corner {rc_worst}
create_delay_corner -name min_delay -library_set {min_lib} -rc_corner {rc_best}
create_analysis_view -name max_worst -constraint_mode {sdc} -delay_corner {max_delay}
create_analysis_view -name min_best -constraint_mode {sdc} -delay_corner {min_delay}
set_analysis_view -setup {max_worst} -hold {min_best}

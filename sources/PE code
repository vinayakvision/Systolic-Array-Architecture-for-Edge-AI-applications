module block(
    input        clk, rst,
    input [63:0] p_sum,
    input [31:0] w_b,
    input [31:0] inp_west,
    output reg [31:0] outp_east,
    output reg [63:0] result
);
    wire [63:0] mult = w_b * inp_west;
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            result    <= 64'd0;
            outp_east <= 32'd0;
        end else begin
            result    <= p_sum + mult;
            outp_east <= inp_west;
        end
    end
endmodule

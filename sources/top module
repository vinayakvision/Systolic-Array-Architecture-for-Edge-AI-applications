
module systolic_array(
    input  wire        clk, rst,
    input  wire [511:0] inp_west,  // Flattened input (16x32 bits)
    output wire [63:0]  Re1, Re2, Re3, Re4
);

    // Unpack the flattened bus into 16 x 32-bit words
    wire [31:0] inp_west_array [0:15];
    genvar i;
    generate
        for (i = 0; i < 16; i = i + 1)
            assign inp_west_array[i] = inp_west[(i+1)*32-1 -: 32];
    endgenerate

    // Internal registers
    reg [3:0] count;
    reg [31:0] inP1, inP5, inP9, inP13;

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            count <= 4'd0;
            inP1 <= 0; inP5 <= 0; inP9 <= 0; inP13 <= 0;
        end else begin
            count <= count + 1;
            case (count)
                0: inP1 <= inp_west_array[0];
                1: begin 
                    inP1 <= inp_west_array[1]; 
                    inP5 <= inp_west_array[4]; 
                end
                2: begin 
                    inP1 <= inp_west_array[2]; 
                    inP5 <= inp_west_array[5]; 
                    inP9 <= inp_west_array[8]; 
                end
                3: begin 
                    inP1 <= inp_west_array[3]; 
                    inP5 <= inp_west_array[6]; 
                    inP9 <= inp_west_array[9]; 
                    inP13 <= inp_west_array[12]; 
                end
                4: begin 
                    inP5 <= inp_west_array[7]; 
                    inP9 <= inp_west_array[10]; 
                    inP13 <= inp_west_array[13]; 
                end
                5: begin 
                    inP9 <= inp_west_array[11]; 
                    inP13 <= inp_west_array[14]; 
                end
                6: inP13 <= inp_west_array[15];
                default: ;
            endcase
        end
    end

    // Constant stationary weights
    wire [31:0] w_b_1  = 32'd1, w_b_2  = 32'd0, w_b_3  = 32'd0, w_b_4  = 32'd0;
    wire [31:0] w_b_5  = 32'd0, w_b_6  = 32'd1, w_b_7  = 32'd0, w_b_8  = 32'd0;
    wire [31:0] w_b_9  = 32'd0, w_b_10 = 32'd0, w_b_11 = 32'd1, w_b_12 = 32'd0;
    wire [31:0] w_b_13 = 32'd0, w_b_14 = 32'd0, w_b_15 = 32'd0, w_b_16 = 32'd1;

    // interconnect wires
    wire [31:0] R_0_1, R_0_2, R_0_3, R_0_4;
    wire [31:0] R_1_1, R_1_2, R_1_3, R_1_4;
    wire [31:0] R_2_1, R_2_2, R_2_3, R_2_4;
    wire [31:0] R_3_1, R_3_2, R_3_3, R_3_4;

    wire [63:0] C_0_1, C_0_2, C_0_3;
    wire [63:0] C_1_1, C_1_2, C_1_3;
    wire [63:0] C_2_1, C_2_2, C_2_3;
    wire [63:0] C_3_1, C_3_2, C_3_3;

    wire [63:0] p_sum = 64'd0;

    // PE instantiation (unchanged logic)
    block P1 (clk, rst, p_sum, w_b_1, inP1, R_0_1, C_0_1);
    block P2 (clk, rst, p_sum, w_b_2, R_0_1, R_0_2, C_1_1);
    block P3 (clk, rst, p_sum, w_b_3, R_0_2, R_0_3, C_2_1);
    block P4 (clk, rst, p_sum, w_b_4, R_0_3, R_0_4, C_3_1);

    block P5 (clk, rst, C_0_1, w_b_5, inP5, R_1_1, C_0_2);
    block P6 (clk, rst, C_1_1, w_b_6, R_1_1, R_1_2, C_1_2);
    block P7 (clk, rst, C_2_1, w_b_7, R_1_2, R_1_3, C_2_2);
    block P8 (clk, rst, C_3_1, w_b_8, R_1_3, R_1_4, C_3_2);

    block P9  (clk, rst, C_0_2, w_b_9, inP9, R_2_1, C_0_3);
    block P10 (clk, rst, C_1_2, w_b_10, R_2_1, R_2_2, C_1_3);
    block P11 (clk, rst, C_2_2, w_b_11, R_2_2, R_2_3, C_2_3);
    block P12 (clk, rst, C_3_2, w_b_12, R_2_3, R_2_4, C_3_3);

    block P13 (clk, rst, C_0_3, w_b_13, inP13, R_3_1, Re1);
    block P14 (clk, rst, C_1_3, w_b_14, R_3_1, R_3_2, Re2);
    block P15 (clk, rst, C_2_3, w_b_15, R_3_2, R_3_3, Re3);
    block P16 (clk, rst, C_3_3, w_b_16, R_3_3, R_3_4, Re4);

endmodule

// Code your design here
`timescale 1ns / 1ps

// ============================================
// ASIC-Style Single-Port SRAM Model
// ============================================
module asic_sram_macro #(
    parameter DATA_W = 32,
    parameter ADDR_W = 4
)(
    input  wire              clk,
    input  wire              cs,   
    input  wire              we,   
    input  wire [ADDR_W-1:0] addr,
    input  wire [DATA_W-1:0] din,
    output reg  [DATA_W-1:0] dout
);
    reg [DATA_W-1:0] mem [0:(1<<ADDR_W)-1];
    always @(posedge clk) begin
        if (cs) begin
            if (we) mem[addr] <= din;
            dout <= mem[addr];
        end
    end
endmodule

// ============================================
// Processing Element (PE)
// ============================================
module block(p_sum, w_b, inp_west, clk, rst, outp_east, result);
    input [31:0] w_b, inp_west;
    input [63:0] p_sum;
    input clk, rst;
    output reg [31:0] outp_east;
    output reg [63:0] result;
    
    wire [63:0] mult = inp_west * w_b; 
    
    always @(posedge clk or posedge rst) begin
        if(rst) begin
            result <= 0;
            outp_east <= 0;
        end else begin
            result <= p_sum + mult; 
            outp_east <= inp_west;
        end
    end
endmodule

// ============================================
// Top Level Systolic Array
// ============================================
module systolic_array(
    input  wire        clk,
    input  wire        rst,
    input  wire        load_trigger,
    input  wire        mem_we,
    input  wire [3:0]  mem_addr,
    input  wire [31:0] weight_din,
    input  wire [31:0] act_din,
    output wire [63:0] Re1, Re2, Re3, Re4
);
    wire [31:0] sram_w_out, sram_a_out;
    reg  [3:0]  internal_addr;
    wire [3:0]  final_addr = mem_we ? mem_addr : internal_addr;

    asic_sram_macro W_SRAM (.clk(clk), .cs(1'b1), .we(mem_we), .addr(final_addr), .din(weight_din), .dout(sram_w_out));
    asic_sram_macro A_SRAM (.clk(clk), .cs(1'b1), .we(mem_we), .addr(final_addr), .din(act_din),    .dout(sram_a_out));

    reg [31:0] weight_reg [0:15];
    reg [31:0] act_reg [0:15];
    reg [3:0]  count;
    reg [31:0] inP1, inP5, inP9, inP13;
    reg        loaded, fetch_done;

    wire [63:0] C [0:3][0:3];
    wire [31:0] E [0:3][0:3];

    // Control Logic: Sequential Fetch & Wavefront
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            count <= 0; internal_addr <= 0; loaded <= 0; fetch_done <= 0;
            inP1 <= 0; inP5 <= 0; inP9 <= 0; inP13 <= 0;
        end else if (load_trigger && !loaded) begin
            if (internal_addr < 15) begin
                internal_addr <= internal_addr + 1;
                if (internal_addr > 0) begin
                    weight_reg[internal_addr-1] <= sram_w_out;
                    act_reg[internal_addr-1]    <= sram_a_out;
                end
            end else if (!fetch_done) begin
                weight_reg[14] <= sram_w_out;
                act_reg[14]    <= sram_a_out;
                fetch_done <= 1; 
            end else begin
                weight_reg[15] <= sram_w_out;
                act_reg[15]    <= sram_a_out;
                loaded <= 1;
            end
        end else if (loaded) begin
            if (count < 8) begin
                count <= count + 1;
                case (count)
                    0: inP1  <= act_reg[0];
                    1: begin inP1 <= act_reg[4];  inP5 <= act_reg[1]; end
                    2: begin inP1 <= act_reg[8];  inP5 <= act_reg[5];  inP9 <= act_reg[2]; end
                    3: begin inP1 <= act_reg[12]; inP5 <= act_reg[9];  inP9 <= act_reg[6];  inP13 <= act_reg[3]; end
                    4: begin inP1 <= 0;           inP5 <= act_reg[13]; inP9 <= act_reg[10]; inP13 <= act_reg[7]; end
                    5: begin                      inP5 <= 0;           inP9 <= act_reg[14]; inP13 <= act_reg[11]; end
                    6: begin                                           inP9 <= 0;           inP13 <= act_reg[15]; end
                    7: begin                                                                inP13 <= 0; loaded <= 0; end
                endcase
            end
        end
    end

    // PE Grid Instantiations
    block P1 (64'd0,   weight_reg[0],  inP1,    clk, rst, E[0][0], C[0][0]);
    block P2 (64'd0,   weight_reg[1],  E[0][0], clk, rst, E[0][1], C[0][1]);
    block P3 (64'd0,   weight_reg[2],  E[0][1], clk, rst, E[0][2], C[0][2]);
    block P4 (64'd0,   weight_reg[3],  E[0][2], clk, rst, E[0][3], C[0][3]);
    block P5 (C[0][0], weight_reg[4],  inP5,    clk, rst, E[1][0], C[1][0]);
    block P6 (C[0][1], weight_reg[5],  E[1][0], clk, rst, E[1][1], C[1][1]);
    block P7 (C[0][2], weight_reg[6],  E[1][1], clk, rst, E[1][2], C[1][2]);
    block P8 (C[0][3], weight_reg[7],  E[1][2], clk, rst, E[1][3], C[1][3]);
    block P9 (C[1][0], weight_reg[8],  inP9,    clk, rst, E[2][0], C[2][0]);
    block P10(C[1][1], weight_reg[9],  E[2][0], clk, rst, E[2][1], C[2][1]);
    block P11(C[1][2], weight_reg[10], E[2][1], clk, rst, E[2][2], C[2][2]);
    block P12(C[1][3], weight_reg[11], E[2][2], clk, rst, E[2][3], C[2][3]);
    block P13(C[2][0], weight_reg[12], inP13,   clk, rst, E[3][0], Re1);
    block P14(C[2][1], weight_reg[13], E[3][0], clk, rst, E[3][1], Re2);
    block P15(C[2][2], weight_reg[14], E[3][1], clk, rst, E[3][2], Re3);
    block P16(C[2][3], weight_reg[15], E[3][2], clk, rst, E[3][3], Re4);
endmodule

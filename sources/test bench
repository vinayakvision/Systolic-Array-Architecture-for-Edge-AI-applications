`timescale 1ns / 1ps

module tb_systolic_array();
    reg clk, rst, load_trigger, mem_we;
    reg [3:0] mem_addr;
    reg [31:0] weight_din, act_din;
    wire [63:0] Re1, Re2, Re3, Re4;

    systolic_array uut (
        .clk(clk), .rst(rst), .load_trigger(load_trigger),
        .mem_we(mem_we), .mem_addr(mem_addr),
        .weight_din(weight_din), .act_din(act_din),
        .Re1(Re1), .Re2(Re2), .Re3(Re3), .Re4(Re4)
    );

    always #5 clk = ~clk;

    initial begin
        // --- Step 1: Initialize ---
        clk = 0; rst = 1; load_trigger = 0; mem_we = 0;
        #20 rst = 0;

        // --- Step 2: Write to SRAMs ---
        for (integer i = 0; i < 16; i = i + 1) begin
            @(posedge clk);
            mem_we = 1; mem_addr = i;
            weight_din = i+1;
            act_din = i + 1; // 1 to 16
        end
        @(posedge clk); mem_we = 0;

        // --- Step 3: Trigger Internal Load ---
        #10;
        @(posedge clk); load_trigger = 1;
        wait(uut.loaded == 1);
        @(posedge clk); load_trigger = 0;

        // --- Step 4: Run Simulation ---
        repeat (25) @(posedge clk);
        $display("Simulation Complete.");
        $finish;
    end

    // Use $strobe to align terminal output with Waveform exactly
    initial begin
        $display("Time | Count | Re1 | Re2 | Re3 | Re4");
        forever begin
            @(posedge clk);
            if (uut.loaded || Re1 != 0 || Re4 != 0)
                $strobe("%4t | %5d | %3d | %3d | %3d | %3d", 
                         $time, uut.count, Re1, Re2, Re3, Re4);
        end
     
    end
  
  initial begin
   $dumpfile("dump.vcd"); $dumpvars;
  end
  
endmodule
